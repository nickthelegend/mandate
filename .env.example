# Read-only RPC for Sepolia.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Funds claims, signs the work transactions, and submits x402 settlements as the
# facilitator. Needs Sepolia ETH for gas and some of the tokens below.
DEPLOYER_PRIVATE_KEY=

# Organisation API key, starts with kh_. Release and refund execute through it.
# Everything read-only -- including verifying any transaction -- works without it.
KEEPERHUB_API_KEY=

# Sepolia test token the escrow is denominated in.
POLARIS_USDC=0x49C86277a91002c4943837bf20F6ED41976Db09F

# Deployed escrow. Override to point at your own.
OUTCOME_ESCROW=0x0ED9d1235cB9FD080D687FD978a38d972a34dC3B

# --- x402 gateway (apps/gateway) ---

# EIP-3009 token. x402's `exact` scheme needs transferWithAuthorization, which
# POLARIS_USDC does not implement.
X402_ASSET=0x0d864A625c280F7f9B9AD024d12F94f5D6DCCF13

# The merchant being paid. Deliberately not the facilitator: collapsing the two
# would make the demo a self-transfer, where the party checking the payment is
# also the party receiving it.
# X402_PAY_TO=0x000000000000000000000000000000000000dEaD

# Price of the gated resource, in base units. 1000000 = 1.00 at six decimals.
# X402_PRICE=1000000

# --- optional ---

# Where the decision record is appended. "-" disables it.
# OUTCOME_AUDIT_LOG=.outcome/audit.jsonl

# Only needed for Etherscan-native verification. Contracts are already verified
# on Sourcify, which needs no key: node contracts/scripts/verify-sourcify.mjs
# ETHERSCAN_API_KEY=
