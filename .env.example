# Mandate — the gateway needs the first four. Everything else has a default.
#
# Read-only surfaces work with none of this: the rule engine is pure, the
# receipt verifier talks to a public RPC, and every read-only MCP tool answers
# without a credential. What is below is what it takes to *decide* and *spend*.

# --- required ---

# The durable ledger. Budgets, duplicate windows, cooldowns, the decision
# record, escalations and receipts all live here, which is what makes a daily
# budget a budget rather than a per-process suggestion.
MONGODB_URI=

# The database inside that cluster.
#
# It must match the deployed gateway's, and this line exists because it once
# did not: a local copy said `outcome` (the name this project had before it was
# renamed) while production said `mandate`, so every direct-database check read
# a stale copy with a third of the rows and none of the notification
# deliveries. The tests passed, against the wrong system. `/health` now reports
# the database it is using, and the suite asserts the two agree.
MANDATE_AUDIT_DB=mandate

# Organisation API key, starts with kh_. Every write goes through KeeperHub:
# policy anchors, approved transfers, receipt batch anchors. Without it the
# authority still refuses correctly — it just cannot approve anything, which is
# the right way round for a failure.
KEEPERHUB_API_KEY=

# The on-chain policy this gateway enforces, assigned by `registerPolicy`.
# Anchor a document first: `node apps/gateway/src/anchor-policy.ts --register`
POLICY_ID=

# --- optional, with working defaults ---

# PolicyRegistry on Sepolia. The anchor every decision is checked against.
POLICY_REGISTRY=0x13452fcA19819d37Fa4b01a0e64C8Fce60C5E304

# MandateReceipts on Sepolia. Where decision-batch roots are anchored.
MANDATE_RECEIPTS=0x64AE971Fda589E4C878F66452b8CE0533032f60d

# tUSDC on Sepolia — what an approved spend actually moves.
MANDATE_TOKEN=0x49C86277a91002c4943837bf20F6ED41976Db09F

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Who may release a held spend, and up to how much. The policy owner — not the
# agent, which is the whole point: an agent that could answer its own
# escalations has a limit it can lift by asking itself.
# AUTHORITY_OPERATORS=0x…
# AUTHORITY_MAX_APPROVAL=2
# AUTHORITY_ESCALATION_TIMEOUT=900

# Where a held-spend notice is delivered. Unset means no notifier, and the
# escalation records `via: "none"` — a more honest statement than silence.
# MANDATE_OPERATOR_WEBHOOK=https://your-endpoint.example/hook
# MANDATE_CONSOLE_URL=https://nickthelegend.github.io/mandate/authority/

# Anchoring a policy needs a key that can pay Sepolia gas. Not used to spend:
# transfers are signed by KeeperHub, which is the claim the product rests on.
# DEPLOYER_PRIVATE_KEY=

# Only for Etherscan-native verification. Contracts are already verified on
# Sourcify, which needs no key: node contracts/scripts/verify-sourcify.mjs
# ETHERSCAN_API_KEY=
