{
  "name": "mandate-policy",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic spend-authority engine: decides whether an autonomous agent may spend, before any money moves.",
  "main": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./canon": {
      "types": "./dist/types/canon/index.d.ts",
      "import": "./dist/esm/canon/index.js",
      "default": "./dist/esm/canon/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "canonicalize": "^3.0.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickthelegend/mandate.git",
    "directory": "packages/policy"
  }
}
